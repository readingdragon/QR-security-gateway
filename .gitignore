# Gradle caches and generated build outputs
.gradle/
.kotlin/
**/build/

# Machine-specific local Android SDK path
local.properties

# IDE and generated files
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/
.DS_Store
*.log
*.hprof

# Build artifacts
*.apk
*.aab
output-metadata.json

# Signing material and secrets
*.jks
*.keystore
google-services.json

# IMPORTANT: do NOT ignore Gradle build scripts or the wrapper!
# Commit build.gradle.kts, settings.gradle.kts, gradle.properties,
# gradlew, gradlew.bat and gradle/wrapper/* (including gradle-wrapper.jar).
# Review gradle.properties for secrets before committing it.
